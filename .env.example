# ---------------------------------------------------------------------------
# UPAR AI — variáveis de ambiente
# Sem as variáveis do Supabase o site roda com o catálogo demonstrativo
# em memória (ideal para homologação do layout).
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://ai.upartech.com.br

# Supabase (banco, autenticação e storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Acesso ao painel enquanto o Supabase Auth não estiver configurado.
# Em produção, remova estas variáveis e use exclusivamente o Supabase Auth.
ADMIN_DEMO_EMAIL=admin@uparai.com.br
ADMIN_DEMO_PASSWORD=upar-ai-demo
ADMIN_SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Mensuração (também configuráveis pelo painel administrativo)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
